{
    "name": "datomatic/filament-db-opening-hours",
    "description": "Filament plugin to manage opening hours stored with datomatic/db-opening-hours",
    "keywords": [
        "Datomatic",
        "laravel",
        "filament",
        "filament-plugin",
        "opening-hours",
        "filament-db-opening-hours"
    ],
    "homepage": "https://github.com/datomatic/filament-db-opening-hours",
    "support": {
        "issues": "https://github.com/datomatic/filament-db-opening-hours/issues",
        "source": "https://github.com/datomatic/filament-db-opening-hours"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Alberto Peripolli",
            "email": "info@albertoperipolli.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "datomatic/db-opening-hours": "^1.1",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Datomatic\\FilamentDatabaseOpeningHours\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Datomatic\\FilamentDatabaseOpeningHours\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Datomatic\\FilamentDatabaseOpeningHours\\FilamentDatabaseOpeningHoursServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
